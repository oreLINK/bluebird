{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bluebird schemas`. Do not edit by hand.",
  "$defs": {
    "Footer": {
      "additionalProperties": false,
      "description": "Site footer: link to the source repository, then links to pages.",
      "properties": {
        "repository": {
          "pattern": "^https://\\S+$",
          "title": "Repository",
          "type": "string"
        },
        "pages": {
          "description": "Ids of the pages linked from the footer, in order.",
          "items": {
            "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Pages",
          "type": "array"
        }
      },
      "required": [
        "repository",
        "pages"
      ],
      "title": "Footer",
      "type": "object"
    },
    "Localized": {
      "additionalProperties": false,
      "description": "A user-facing string in every supported UI language.",
      "properties": {
        "fr": {
          "minLength": 1,
          "title": "Fr",
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "es": {
          "minLength": 1,
          "title": "Es",
          "type": "string"
        }
      },
      "required": [
        "fr",
        "en",
        "es"
      ],
      "title": "Localized",
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "description": "A full-window page opened over the site (about, legal notice…).",
      "properties": {
        "id": {
          "description": "Also the URL hash that opens the page (#<id>).",
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/Localized"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/PageSection"
          },
          "minItems": 1,
          "title": "Sections",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "sections"
      ],
      "title": "Page",
      "type": "object"
    },
    "PageLink": {
      "additionalProperties": false,
      "description": "An external link listed in a page section.",
      "properties": {
        "label": {
          "$ref": "#/$defs/Localized"
        },
        "url": {
          "pattern": "^https://\\S+$",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "title": "PageLink",
      "type": "object"
    },
    "PageSection": {
      "additionalProperties": false,
      "description": "A titled section of a page: paragraphs, links and/or a built-in block.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/Localized"
        },
        "paragraphs": {
          "items": {
            "$ref": "#/$defs/Localized"
          },
          "title": "Paragraphs",
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/PageLink"
          },
          "title": "Links",
          "type": "array"
        },
        "block": {
          "anyOf": [
            {
              "enum": [
                "data_sources",
                "photo_credits",
                "local_data",
                "tile_front",
                "tile_back",
                "time_badges",
                "service_summary",
                "service_sources",
                "service_transforms",
                "service_kpis",
                "service_tiles"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Content generated by the site after the paragraphs: data_sources lists the attribution of every enabled source (config/sources.yaml); photo_credits lists every banner photo credit (web/src/assets/photos/credits.yaml); local_data lists the settings stored on the device and a button to delete them; tile_front and tile_back draw an example tile (front, back) with numbered marks that the paragraphs of the next section explain; time_badges lists every time badge (days and moments, from config/periods.yaml); service_* show the status of the last refresh (diamond/status.json): summary, data sources, transformations, KPIs, tiles of the current massif.",
          "title": "Block"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "PageSection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema of ``config/pages.yaml``: footer and full-window pages.",
  "properties": {
    "footer": {
      "$ref": "#/$defs/Footer"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/Page"
      },
      "title": "Pages",
      "type": "array"
    }
  },
  "required": [
    "footer",
    "pages"
  ],
  "title": "PagesFile",
  "type": "object"
}
