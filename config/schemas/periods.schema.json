{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bluebird schemas`. Do not edit by hand.",
  "$defs": {
    "Localized": {
      "additionalProperties": false,
      "description": "A user-facing string in every supported UI language.",
      "properties": {
        "fr": {
          "minLength": 1,
          "title": "Fr",
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        }
      },
      "required": [
        "fr",
        "en"
      ],
      "title": "Localized",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "description": "A time slot of the ski day a KPI is computed for (morning, evening…).",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "start": {
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "description": "'00:00' after a later start means midnight.",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "title": "End",
          "type": "string"
        },
        "native_window": {
          "default": false,
          "description": "The KPI computes over its own window (e.g. the whole ski day); `start`/`end` then only decide when the period is shown.",
          "title": "Native Window",
          "type": "boolean"
        },
        "labels": {
          "description": "Label per day offset: [today, tomorrow, …], used in tile titles.",
          "items": {
            "$ref": "#/$defs/Localized"
          },
          "minItems": 1,
          "title": "Labels",
          "type": "array"
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "labels"
      ],
      "title": "Period",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema of ``config/periods.yaml``.",
  "properties": {
    "day_start": {
      "default": "06:00",
      "description": "Local time a ski day starts: ski day D runs from D day_start to D+1.",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "title": "Day Start",
      "type": "string"
    },
    "horizon_days": {
      "default": 2,
      "description": "Ski days published: 1 = today, 2 = + tomorrow.",
      "maximum": 7,
      "minimum": 1,
      "title": "Horizon Days",
      "type": "integer"
    },
    "periods": {
      "items": {
        "$ref": "#/$defs/Period"
      },
      "minItems": 1,
      "title": "Periods",
      "type": "array"
    }
  },
  "required": [
    "periods"
  ],
  "title": "PeriodsFile",
  "type": "object"
}
