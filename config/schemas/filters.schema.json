{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bluebird schemas`. Do not edit by hand.",
  "$defs": {
    "Filter": {
      "additionalProperties": false,
      "description": "A chip of the filter bar: shows the tiles of the KPIs tagged with its id.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Localized"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon"
        },
        "all": {
          "default": false,
          "description": "Show every tile, except those of exclusive filters.",
          "title": "All",
          "type": "boolean"
        },
        "exclusive": {
          "default": false,
          "description": "Its tiles appear only under this filter, never under an `all` filter.",
          "title": "Exclusive",
          "type": "boolean"
        },
        "theme": {
          "default": "default",
          "description": "Colour of the chip (rewind: Christmas red).",
          "enum": [
            "default",
            "rewind"
          ],
          "title": "Theme",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Filter",
      "type": "object"
    },
    "Localized": {
      "additionalProperties": false,
      "description": "A user-facing string in every supported UI language.",
      "properties": {
        "fr": {
          "minLength": 1,
          "title": "Fr",
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        }
      },
      "required": [
        "fr",
        "en"
      ],
      "title": "Localized",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema of ``config/filters.yaml``: the filter bar, in display order.",
  "properties": {
    "filters": {
      "items": {
        "$ref": "#/$defs/Filter"
      },
      "minItems": 1,
      "title": "Filters",
      "type": "array"
    }
  },
  "required": [
    "filters"
  ],
  "title": "FiltersFile",
  "type": "object"
}
