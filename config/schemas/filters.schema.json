{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bluebird schemas`. Do not edit by hand.",
  "$defs": {
    "Filter": {
      "additionalProperties": false,
      "description": "A level-1 chip of the filter bar: shows the tiles of the KPIs tagged with its id.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Localized"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon"
        },
        "theme": {
          "default": "default",
          "description": "Colour of the chip (rewind: Christmas red; mood: moving multicolour text and border).",
          "enum": [
            "default",
            "rewind",
            "mood"
          ],
          "title": "Theme",
          "type": "string"
        },
        "levels": {
          "description": "Levels offered once this filter is chosen, in order: `group` (its `groups`), `day` (today, tomorrow), `slot` (morning, evening…). Live KPIs only.",
          "items": {
            "enum": [
              "group",
              "day",
              "slot",
              "mood_group",
              "mood"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Levels",
          "type": "array"
        },
        "groups": {
          "description": "Sub-categories for the `group` level; every KPI of the filter in one.",
          "items": {
            "$ref": "#/$defs/FilterGroup"
          },
          "title": "Groups",
          "type": "array"
        },
        "moods": {
          "description": "Sub-moods and moods for the `mood_group` and `mood` levels; the filter then shows the KPIs of its moods (no `filters:` tag needed).",
          "items": {
            "$ref": "#/$defs/MoodGroup"
          },
          "title": "Moods",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Filter",
      "type": "object"
    },
    "FilterGroup": {
      "additionalProperties": false,
      "description": "A sub-category of a level-1 filter (level `group`), e.g. Poudreuse under Glisse.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Localized"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon"
        },
        "kpis": {
          "description": "KPIs of the sub-category.",
          "items": {
            "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Kpis",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "kpis"
      ],
      "title": "FilterGroup",
      "type": "object"
    },
    "Localized": {
      "additionalProperties": false,
      "description": "A user-facing string in every supported UI language.",
      "properties": {
        "fr": {
          "minLength": 1,
          "title": "Fr",
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "es": {
          "minLength": 1,
          "title": "Es",
          "type": "string"
        }
      },
      "required": [
        "fr",
        "en",
        "es"
      ],
      "title": "Localized",
      "type": "object"
    },
    "Mood": {
      "additionalProperties": false,
      "description": "A mood (level `mood`), e.g. Freerider: the KPIs that matter for that wish of the day.\n\nUnlike groups, a KPI can belong to several moods; the page shows all of them,\nordered by the home page visibility score (lib/homeFeed.ts).",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Localized"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon"
        },
        "kpis": {
          "description": "Live KPIs shown under this mood.",
          "items": {
            "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Kpis",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "kpis"
      ],
      "title": "Mood",
      "type": "object"
    },
    "MoodGroup": {
      "additionalProperties": false,
      "description": "A sub-mood (level `mood_group`), e.g. Sur place or En route, and its moods.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Localized"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon"
        },
        "tomorrow_only": {
          "default": false,
          "description": "Show tomorrow's periods only, at any time of day (e.g. Je monte demain).",
          "title": "Tomorrow Only",
          "type": "boolean"
        },
        "moods": {
          "items": {
            "$ref": "#/$defs/Mood"
          },
          "minItems": 1,
          "title": "Moods",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "moods"
      ],
      "title": "MoodGroup",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema of ``config/filters.yaml``: the filter bar, in display order.",
  "properties": {
    "filters": {
      "items": {
        "$ref": "#/$defs/Filter"
      },
      "minItems": 1,
      "title": "Filters",
      "type": "array"
    }
  },
  "required": [
    "filters"
  ],
  "title": "FiltersFile",
  "type": "object"
}
