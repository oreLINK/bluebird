{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bluebird schemas`. Do not edit by hand.",
  "$defs": {
    "DisplayBand": {
      "additionalProperties": false,
      "description": "A named band of a `value` display, for values up to `max` (none: every value above).",
      "properties": {
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "label": {
          "$ref": "#/$defs/Localized"
        }
      },
      "required": [
        "label"
      ],
      "title": "DisplayBand",
      "type": "object"
    },
    "DisplayLevel": {
      "additionalProperties": false,
      "description": "A level of a `levels` display, shown from probability `min` (e.g. Oui from 0.6).",
      "properties": {
        "min": {
          "maximum": 1,
          "minimum": 0,
          "title": "Min",
          "type": "number"
        },
        "label": {
          "$ref": "#/$defs/Localized"
        }
      },
      "required": [
        "min",
        "label"
      ],
      "title": "DisplayLevel",
      "type": "object"
    },
    "DriverSpec": {
      "additionalProperties": false,
      "description": "How to display one explanatory value attached to a KPI result.",
      "properties": {
        "label": {
          "$ref": "#/$defs/Localized"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "decimals": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Decimals",
          "type": "integer"
        }
      },
      "required": [
        "label"
      ],
      "title": "DriverSpec",
      "type": "object"
    },
    "Kpi": {
      "additionalProperties": false,
      "description": "A KPI computed by a gold-layer Aggregator.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "aggregator": {
          "description": "Id of a registered gold Aggregator.",
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Aggregator",
          "type": "string"
        },
        "kind": {
          "default": "live",
          "description": "live: probability for today, computed by the daily run; historical: value over a past season, computed by `bluebird rewind` (config/rewinds.yaml).",
          "enum": [
            "live",
            "historical"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit and decimals of the value; required for historical KPIs."
        },
        "display": {
          "$ref": "#/$defs/KpiDisplay",
          "description": "Live KPIs: shown as a percent (default), a value or levels."
        },
        "order": {
          "default": "desc",
          "description": "Ranking order: desc puts the highest value first; asc the lowest (e.g. fewest white days).",
          "enum": [
            "desc",
            "asc"
          ],
          "title": "Order",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "name": {
          "$ref": "#/$defs/Localized"
        },
        "description": {
          "$ref": "#/$defs/Localized"
        },
        "method": {
          "anyOf": [
            {
              "$ref": "#/$defs/Localized"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the KPI is computed, in plain words, shown on the back of its tiles. `{param}` placeholders are replaced by the values of `params`."
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "drivers": {
          "additionalProperties": {
            "$ref": "#/$defs/DriverSpec"
          },
          "title": "Drivers",
          "type": "object"
        },
        "filters": {
          "description": "Ids of the filters (config/filters.yaml) this KPI appears under.",
          "items": {
            "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Filters",
          "type": "array"
        },
        "periods": {
          "description": "Ids of the periods (config/periods.yaml) a live KPI is computed for; ignored for historical KPIs.",
          "items": {
            "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Periods",
          "type": "array"
        }
      },
      "required": [
        "id",
        "aggregator",
        "name",
        "description"
      ],
      "title": "Kpi",
      "type": "object"
    },
    "KpiDisplay": {
      "additionalProperties": false,
      "description": "How a live KPI is shown on its tiles (the probability is always computed).\n\npercent  the probability (\"82 %\"), optionally with a `note` driver in small\n         type (e.g. the sunset time);\nvalue    the median of the scenarios, from `driver`, in the KPI `value` unit\n         (\"4 cm\", \"-24 °C\"); the ranking follows that value (`order`), and\n         reliability comes from the spread between the two `range` drivers\n         (p10, p90): high within `tolerance`, medium within twice it;\n         `bands` name ranges of values (e.g. the wind chill risk);\nlevels   a decision from the probability (\"Oui\", \"Possible\", \"Non\").",
      "properties": {
        "kind": {
          "default": "percent",
          "enum": [
            "percent",
            "value",
            "levels"
          ],
          "title": "Kind",
          "type": "string"
        },
        "driver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "value: driver holding the median.",
          "title": "Driver"
        },
        "range": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "value: p10 and p90 drivers.",
          "title": "Range"
        },
        "tolerance": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "value: p90 - p10 spread of a high reliability.",
          "title": "Tolerance"
        },
        "bands": {
          "items": {
            "$ref": "#/$defs/DisplayBand"
          },
          "title": "Bands",
          "type": "array"
        },
        "levels": {
          "items": {
            "$ref": "#/$defs/DisplayLevel"
          },
          "title": "Levels",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Driver shown in small type.",
          "title": "Note"
        }
      },
      "title": "KpiDisplay",
      "type": "object"
    },
    "Localized": {
      "additionalProperties": false,
      "description": "A user-facing string in every supported UI language.",
      "properties": {
        "fr": {
          "minLength": 1,
          "title": "Fr",
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        }
      },
      "required": [
        "fr",
        "en"
      ],
      "title": "Localized",
      "type": "object"
    },
    "ValueSpec": {
      "additionalProperties": false,
      "description": "Unit of the value of a historical KPI, as published and displayed (e.g. 4.43 m).",
      "properties": {
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "decimals": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Decimals",
          "type": "integer"
        },
        "scale": {
          "default": 1.0,
          "description": "Multiplier from the aggregator's unit (cm for snow, h for durations) to `unit`, e.g. 0.01 to publish centimetres as metres.",
          "exclusiveMinimum": 0,
          "title": "Scale",
          "type": "number"
        },
        "unit_label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Localized"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit as shown on the site when it differs by language (e.g. jours / days)."
        },
        "unit_label_one": {
          "anyOf": [
            {
              "$ref": "#/$defs/Localized"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Singular of `unit_label` (e.g. jour / day), used where the language says so."
        },
        "max": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Value (in `unit`) of a full bar in the tiles, e.g. 100 for a percentage. Default: the best value of the ranking.",
          "title": "Max"
        }
      },
      "required": [
        "unit"
      ],
      "title": "ValueSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema of ``config/kpis.yaml``.",
  "properties": {
    "kpis": {
      "items": {
        "$ref": "#/$defs/Kpi"
      },
      "title": "Kpis",
      "type": "array"
    }
  },
  "required": [
    "kpis"
  ],
  "title": "KpisFile",
  "type": "object"
}
