{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bluebird schemas`. Do not edit by hand.",
  "$defs": {
    "DriverSpec": {
      "additionalProperties": false,
      "description": "How to display one explanatory value attached to a KPI result.",
      "properties": {
        "label": {
          "$ref": "#/$defs/Localized"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "decimals": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Decimals",
          "type": "integer"
        }
      },
      "required": [
        "label"
      ],
      "title": "DriverSpec",
      "type": "object"
    },
    "Kpi": {
      "additionalProperties": false,
      "description": "A KPI computed by a gold-layer Aggregator.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "aggregator": {
          "description": "Id of a registered gold Aggregator.",
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Aggregator",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "name": {
          "$ref": "#/$defs/Localized"
        },
        "description": {
          "$ref": "#/$defs/Localized"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "drivers": {
          "additionalProperties": {
            "$ref": "#/$defs/DriverSpec"
          },
          "title": "Drivers",
          "type": "object"
        }
      },
      "required": [
        "id",
        "aggregator",
        "name",
        "description"
      ],
      "title": "Kpi",
      "type": "object"
    },
    "Localized": {
      "additionalProperties": false,
      "description": "A user-facing string in every supported UI language.",
      "properties": {
        "fr": {
          "minLength": 1,
          "title": "Fr",
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        }
      },
      "required": [
        "fr",
        "en"
      ],
      "title": "Localized",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema of ``config/kpis.yaml``.",
  "properties": {
    "kpis": {
      "items": {
        "$ref": "#/$defs/Kpi"
      },
      "title": "Kpis",
      "type": "array"
    }
  },
  "required": [
    "kpis"
  ],
  "title": "KpisFile",
  "type": "object"
}
