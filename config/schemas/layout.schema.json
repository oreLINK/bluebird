{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bluebird schemas`. Do not edit by hand.",
  "$defs": {
    "HomeTile": {
      "additionalProperties": false,
      "description": "A tile of the home page (no filter selected), for one of its periods.",
      "properties": {
        "tile": {
          "description": "Live tile of config/tiles.yaml.",
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Tile",
          "type": "string"
        },
        "period": {
          "description": "Period shown (today's, or tomorrow's once today's is over).",
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Period",
          "type": "string"
        }
      },
      "required": [
        "tile",
        "period"
      ],
      "title": "HomeTile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema of ``config/layout.yaml``: home page and tile order, optionally per massif.",
  "properties": {
    "home": {
      "description": "Home page tiles in priority order: the first one is shown first.",
      "items": {
        "$ref": "#/$defs/HomeTile"
      },
      "title": "Home",
      "type": "array"
    },
    "default": {
      "type": "array",
      "items": {
        "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Default"
    },
    "overrides": {
      "additionalProperties": {
        "items": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "type": "string"
        },
        "type": "array"
      },
      "title": "Overrides",
      "type": "object"
    }
  },
  "required": [
    "default"
  ],
  "title": "LayoutFile",
  "type": "object"
}
