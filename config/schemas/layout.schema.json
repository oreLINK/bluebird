{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bluebird schemas`. Do not edit by hand.",
  "$defs": {
    "EarlyAlerts": {
      "additionalProperties": false,
      "description": "Tomorrow's alerts of these filters show from `from` (before the tomorrow steps).",
      "properties": {
        "filters": {
          "items": {
            "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Filters",
          "type": "array"
        },
        "from": {
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "title": "From",
          "type": "string"
        },
        "factor": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Factor",
          "type": "number"
        }
      },
      "required": [
        "filters",
        "from",
        "factor"
      ],
      "title": "EarlyAlerts",
      "type": "object"
    },
    "HomeDiversity": {
      "additionalProperties": false,
      "description": "At most `per_category` tiles of one category among the first `first` ranked tiles.",
      "properties": {
        "first": {
          "default": 6,
          "minimum": 1,
          "title": "First",
          "type": "integer"
        },
        "per_category": {
          "default": 2,
          "minimum": 1,
          "title": "Per Category",
          "type": "integer"
        }
      },
      "title": "HomeDiversity",
      "type": "object"
    },
    "HomePage": {
      "additionalProperties": false,
      "description": "The home page (no filter selected): pinned tiles, then tiles by visibility score.",
      "properties": {
        "mode": {
          "default": "scored",
          "description": "scored: pinned tiles, alerts, then by visibility; fixed: pinned + fallback.",
          "enum": [
            "scored",
            "fixed"
          ],
          "title": "Mode",
          "type": "string"
        },
        "pinned": {
          "description": "Always first, whatever their score, in this order.",
          "items": {
            "$ref": "#/$defs/HomeTile"
          },
          "title": "Pinned",
          "type": "array"
        },
        "fallback": {
          "description": "Shown after the pinned tiles in `fixed` mode, or when no tile is significant.",
          "items": {
            "$ref": "#/$defs/HomeTile"
          },
          "title": "Fallback",
          "type": "array"
        },
        "limit": {
          "default": 50,
          "description": "Most tiles on the home page, pinned included (the footer stays reachable).",
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "top": {
          "default": 3,
          "description": "Stations averaged by the measure.",
          "minimum": 1,
          "title": "Top",
          "type": "integer"
        },
        "relevance": {
          "anyOf": [
            {
              "$ref": "#/$defs/HomeRelevance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reliability": {
          "$ref": "#/$defs/HomeReliability"
        },
        "diversity": {
          "$ref": "#/$defs/HomeDiversity"
        }
      },
      "title": "HomePage",
      "type": "object"
    },
    "HomeRelevance": {
      "additionalProperties": false,
      "description": "Relevance factor of a candidate tile by the time of day (ski day clock).",
      "properties": {
        "slots": {
          "$ref": "#/$defs/SlotRelevance"
        },
        "today": {
          "description": "Steps of today's day-grain periods (day, sunset, overnight) by local time.",
          "patternProperties": {
            "^[a-z0-9]+(?:[_-][a-z0-9]+)*$": {
              "items": {
                "$ref": "#/$defs/RelevanceStep"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "title": "Today",
          "type": "object"
        },
        "tomorrow": {
          "$ref": "#/$defs/TomorrowRelevance"
        },
        "early_alerts": {
          "anyOf": [
            {
              "$ref": "#/$defs/EarlyAlerts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "today",
        "tomorrow"
      ],
      "title": "HomeRelevance",
      "type": "object"
    },
    "HomeReliability": {
      "additionalProperties": false,
      "description": "Reliability factor: confidence of the top stations, stale data, station coverage.",
      "properties": {
        "high": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "High",
          "type": "number"
        },
        "medium": {
          "default": 0.85,
          "maximum": 1,
          "minimum": 0,
          "title": "Medium",
          "type": "number"
        },
        "low": {
          "default": 0.65,
          "maximum": 1,
          "minimum": 0,
          "title": "Low",
          "type": "number"
        },
        "stale": {
          "default": 0.7,
          "description": "Multiplier for stale values.",
          "maximum": 1,
          "minimum": 0,
          "title": "Stale",
          "type": "number"
        },
        "coverage_min": {
          "default": 0.5,
          "description": "Share of the place's stations with a value.",
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage Min",
          "type": "number"
        },
        "coverage": {
          "default": 0.8,
          "description": "Multiplier below `coverage_min`.",
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        }
      },
      "title": "HomeReliability",
      "type": "object"
    },
    "HomeTile": {
      "additionalProperties": false,
      "description": "A tile of the home page (no filter selected), for one of its periods.",
      "properties": {
        "tile": {
          "description": "Live tile of config/tiles.yaml.",
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Tile",
          "type": "string"
        },
        "period": {
          "description": "Period shown (today's, or tomorrow's once today's is over).",
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Period",
          "type": "string"
        }
      },
      "required": [
        "tile",
        "period"
      ],
      "title": "HomeTile",
      "type": "object"
    },
    "RelevanceStep": {
      "additionalProperties": false,
      "description": "From local time `from`, the relevance factor is `factor` (until the next step).",
      "properties": {
        "from": {
          "description": "Local time, on the ski day clock.",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "title": "From",
          "type": "string"
        },
        "factor": {
          "maximum": 1,
          "minimum": 0,
          "title": "Factor",
          "type": "number"
        }
      },
      "required": [
        "from",
        "factor"
      ],
      "title": "RelevanceStep",
      "type": "object"
    },
    "SlotRelevance": {
      "additionalProperties": false,
      "description": "Relevance of today's time slots: in progress, the next one, the later ones.",
      "properties": {
        "current": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Current",
          "type": "number"
        },
        "next": {
          "default": 0.9,
          "maximum": 1,
          "minimum": 0,
          "title": "Next",
          "type": "number"
        },
        "later": {
          "default": 0.7,
          "maximum": 1,
          "minimum": 0,
          "title": "Later",
          "type": "number"
        }
      },
      "title": "SlotRelevance",
      "type": "object"
    },
    "TomorrowRelevance": {
      "additionalProperties": false,
      "description": "Relevance of tomorrow's tiles: 0 before the first step, then step x period factor.",
      "properties": {
        "steps": {
          "items": {
            "$ref": "#/$defs/RelevanceStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "slots": {
          "$ref": "#/$defs/TomorrowSlots"
        }
      },
      "required": [
        "steps"
      ],
      "title": "TomorrowRelevance",
      "type": "object"
    },
    "TomorrowSlots": {
      "additionalProperties": false,
      "description": "Factor of tomorrow's time slots: the first one of the day, the others.",
      "properties": {
        "first": {
          "default": 0.9,
          "maximum": 1,
          "minimum": 0,
          "title": "First",
          "type": "number"
        },
        "later": {
          "default": 0.6,
          "maximum": 1,
          "minimum": 0,
          "title": "Later",
          "type": "number"
        }
      },
      "title": "TomorrowSlots",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema of ``config/layout.yaml``: home page and tile order, optionally per massif.",
  "properties": {
    "home": {
      "$ref": "#/$defs/HomePage",
      "description": "Home page: pinned tiles, then tiles ranked by their visibility score."
    },
    "default": {
      "type": "array",
      "items": {
        "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Default"
    },
    "overrides": {
      "additionalProperties": {
        "items": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "type": "string"
        },
        "type": "array"
      },
      "title": "Overrides",
      "type": "object"
    }
  },
  "required": [
    "default"
  ],
  "title": "LayoutFile",
  "type": "object"
}
