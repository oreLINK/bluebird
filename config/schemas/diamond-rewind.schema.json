{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bluebird schemas`. Do not edit by hand.",
  "$defs": {
    "DiamondElevation": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "title": "Base",
          "type": "integer"
        },
        "mid": {
          "title": "Mid",
          "type": "integer"
        },
        "summit": {
          "title": "Summit",
          "type": "integer"
        }
      },
      "required": [
        "base",
        "mid",
        "summit"
      ],
      "title": "DiamondElevation",
      "type": "object"
    },
    "DiamondRewindEntry": {
      "additionalProperties": false,
      "properties": {
        "station_id": {
          "title": "Station Id",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "drivers": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Drivers",
          "type": "object"
        }
      },
      "required": [
        "station_id",
        "value",
        "drivers"
      ],
      "title": "DiamondRewindEntry",
      "type": "object"
    },
    "DiamondRewindKpi": {
      "additionalProperties": false,
      "properties": {
        "kpi_id": {
          "title": "Kpi Id",
          "type": "string"
        },
        "aggregator_version": {
          "title": "Aggregator Version",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "ranking": {
          "description": "Best first: by value, descending unless the KPI `order` is asc.",
          "items": {
            "$ref": "#/$defs/DiamondRewindEntry"
          },
          "title": "Ranking",
          "type": "array"
        }
      },
      "required": [
        "kpi_id",
        "aggregator_version",
        "unit",
        "ranking"
      ],
      "title": "DiamondRewindKpi",
      "type": "object"
    },
    "DiamondSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "License"
        }
      },
      "required": [
        "id",
        "name",
        "url",
        "license"
      ],
      "title": "DiamondSource",
      "type": "object"
    },
    "DiamondStation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "short_name": {
          "description": "Compact name for tiles (falls back to `name`).",
          "title": "Short Name",
          "type": "string"
        },
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "elevation": {
          "$ref": "#/$defs/DiamondElevation"
        },
        "aspects": {
          "items": {
            "type": "string"
          },
          "title": "Aspects",
          "type": "array"
        },
        "website": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Website"
        }
      },
      "required": [
        "id",
        "name",
        "short_name",
        "lat",
        "lon",
        "elevation",
        "aspects",
        "website"
      ],
      "title": "DiamondStation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``config/rewind/{rewind_id}/{massif_id}.json``: a closed season, ranked.\n\nGenerated once by ``bluebird rewind`` and committed (the site bundles it at\nbuild time); never edited by hand.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "rewind_id": {
      "title": "Rewind Id",
      "type": "string"
    },
    "massif_id": {
      "title": "Massif Id",
      "type": "string"
    },
    "start": {
      "description": "First day of the season (local), included.",
      "format": "date",
      "title": "Start",
      "type": "string"
    },
    "end": {
      "description": "Last day of the season (local), included.",
      "format": "date",
      "title": "End",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "timezone": {
      "title": "Timezone",
      "type": "string"
    },
    "stations": {
      "additionalProperties": {
        "$ref": "#/$defs/DiamondStation"
      },
      "title": "Stations",
      "type": "object"
    },
    "kpis": {
      "additionalProperties": {
        "$ref": "#/$defs/DiamondRewindKpi"
      },
      "title": "Kpis",
      "type": "object"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/DiamondSource"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "rewind_id",
    "massif_id",
    "start",
    "end",
    "generated_at",
    "timezone",
    "stations",
    "kpis",
    "sources"
  ],
  "title": "DiamondRewind",
  "type": "object"
}
