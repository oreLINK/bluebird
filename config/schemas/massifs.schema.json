{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bluebird schemas`. Do not edit by hand.",
  "$defs": {
    "Localized": {
      "additionalProperties": false,
      "description": "A user-facing string in every supported UI language.",
      "properties": {
        "fr": {
          "minLength": 1,
          "title": "Fr",
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        }
      },
      "required": [
        "fr",
        "en"
      ],
      "title": "Localized",
      "type": "object"
    },
    "Massif": {
      "additionalProperties": false,
      "description": "A mountain range grouping several stations.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Localized"
        },
        "timezone": {
          "default": "Europe/Paris",
          "title": "Timezone",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "order": {
          "default": 100,
          "description": "Sort order in the massif picker.",
          "title": "Order",
          "type": "integer"
        },
        "bbox": {
          "description": "[min_lon, min_lat, max_lon, max_lat]",
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Bbox",
          "type": "array"
        },
        "skyline": {
          "description": "Relative ridge heights (0..1), west to east, for the decorative backdrop.",
          "items": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "title": "Skyline",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "bbox"
      ],
      "title": "Massif",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema of ``config/massifs.yaml``.",
  "properties": {
    "massifs": {
      "items": {
        "$ref": "#/$defs/Massif"
      },
      "title": "Massifs",
      "type": "array"
    }
  },
  "required": [
    "massifs"
  ],
  "title": "MassifsFile",
  "type": "object"
}
