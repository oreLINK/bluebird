{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bluebird schemas`. Do not edit by hand.",
  "$defs": {
    "Attribution": {
      "additionalProperties": false,
      "description": "Credit displayed in the site footer.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "title": "Attribution",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "A data source: a bronze Extractor paired with a silver Transformer.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "extractor": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Extractor",
          "type": "string"
        },
        "transformer": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Transformer",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "schedule": {
          "default": "daily",
          "enum": [
            "daily",
            "on_demand"
          ],
          "title": "Schedule",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "attribution": {
          "$ref": "#/$defs/Attribution"
        }
      },
      "required": [
        "id",
        "extractor",
        "transformer",
        "attribution"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema of ``config/sources.yaml``.",
  "properties": {
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "sources"
  ],
  "title": "SourcesFile",
  "type": "object"
}
