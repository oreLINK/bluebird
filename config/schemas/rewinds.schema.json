{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bluebird schemas`. Do not edit by hand.",
  "$defs": {
    "Localized": {
      "additionalProperties": false,
      "description": "A user-facing string in every supported UI language.",
      "properties": {
        "fr": {
          "minLength": 1,
          "title": "Fr",
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        }
      },
      "required": [
        "fr",
        "en"
      ],
      "title": "Localized",
      "type": "object"
    },
    "Rewind": {
      "additionalProperties": false,
      "description": "A Rewind: the review of a closed ski season, ranked on historical KPIs.",
      "properties": {
        "id": {
          "description": "Season id, e.g. 2025-26; also the folder in config/rewind/.",
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Localized"
        },
        "start": {
          "description": "First day of the season (local), included.",
          "format": "date",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "description": "Last day of the season (local), included.",
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "massifs": {
          "items": {
            "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Massifs",
          "type": "array"
        },
        "kpis": {
          "description": "Historical KPIs of this Rewind.",
          "items": {
            "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Kpis",
          "type": "array"
        },
        "filter": {
          "description": "Exclusive filter (config/filters.yaml) showing its tiles.",
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Filter",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "start",
        "end",
        "massifs",
        "kpis",
        "filter"
      ],
      "title": "Rewind",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema of ``config/rewinds.yaml``.",
  "properties": {
    "rewinds": {
      "items": {
        "$ref": "#/$defs/Rewind"
      },
      "title": "Rewinds",
      "type": "array"
    }
  },
  "title": "RewindsFile",
  "type": "object"
}
