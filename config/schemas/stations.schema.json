{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bluebird schemas`. Do not edit by hand.",
  "$defs": {
    "Domain": {
      "additionalProperties": false,
      "description": "A linked ski area spanning several stations (Les 3 Vallées, Portes du Soleil…),\nlevel 3 of the massif bar; its stations may sit in several zones or countries.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Domain",
      "type": "object"
    },
    "Elevation": {
      "additionalProperties": false,
      "description": "Elevations of a ski area, in metres.",
      "properties": {
        "base": {
          "maximum": 5000,
          "minimum": 0,
          "title": "Base",
          "type": "integer"
        },
        "summit": {
          "maximum": 5000,
          "minimum": 0,
          "title": "Summit",
          "type": "integer"
        },
        "mid": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to the base/summit average.",
          "title": "Mid"
        }
      },
      "required": [
        "base",
        "summit"
      ],
      "title": "Elevation",
      "type": "object"
    },
    "Station": {
      "additionalProperties": false,
      "description": "A ski resort.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "short_name": {
          "anyOf": [
            {
              "maxLength": 20,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Compact name displayed in the tiles; defaults to `name`.",
          "title": "Short Name"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "elevation": {
          "$ref": "#/$defs/Elevation"
        },
        "aspects": {
          "description": "Dominant slope aspects.",
          "items": {
            "enum": [
              "N",
              "NE",
              "E",
              "SE",
              "S",
              "SW",
              "W",
              "NW"
            ],
            "type": "string"
          },
          "title": "Aspects",
          "type": "array"
        },
        "grooming_end": {
          "anyOf": [
            {
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overrides the default.",
          "title": "Grooming End"
        },
        "lifts_open": {
          "anyOf": [
            {
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overrides the default.",
          "title": "Lifts Open"
        },
        "website": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Website"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "zone": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sub-massif of the station (`zones` of config/massifs.yaml).",
          "title": "Zone"
        },
        "domain": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Linked ski area it belongs to (`domains` of its file).",
          "title": "Domain"
        },
        "webcams": {
          "description": "Live webcams, linked from the tiles (`webcam` rule).",
          "items": {
            "$ref": "#/$defs/Webcam"
          },
          "title": "Webcams",
          "type": "array"
        },
        "avalanche_massif": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of the Météo-France avalanche massif the station belongs to (its avalanche bulletin, KPI `avalanche_risk`); none for a resort without a French bulletin.",
          "title": "Avalanche Massif"
        }
      },
      "required": [
        "id",
        "name",
        "lat",
        "lon",
        "elevation"
      ],
      "title": "Station",
      "type": "object"
    },
    "StationDefaults": {
      "additionalProperties": false,
      "description": "Values applied to every station of the file unless it overrides them.",
      "properties": {
        "grooming_end": {
          "default": "02:00",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Grooming End",
          "type": "string"
        },
        "lifts_open": {
          "default": "09:00",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Lifts Open",
          "type": "string"
        }
      },
      "title": "StationDefaults",
      "type": "object"
    },
    "Webcam": {
      "additionalProperties": false,
      "description": "A live webcam of a station, linked from its tiles (the image itself is never shown).",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Place of the camera, e.g. 'Les Crêtes'.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "position": {
          "enum": [
            "summit",
            "slopes",
            "village",
            "nordic"
          ],
          "title": "Position",
          "type": "string"
        },
        "elevation": {
          "anyOf": [
            {
              "maximum": 9000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Metres.",
          "title": "Elevation"
        },
        "provider": {
          "const": "skaping",
          "description": "Company that streams the webcam.",
          "title": "Provider",
          "type": "string"
        },
        "url": {
          "description": "Official page of the webcam, opened in a new tab.",
          "pattern": "^https://\\S+$",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "position",
        "provider",
        "url"
      ],
      "title": "Webcam",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema of ``config/stations/<massif>.yaml``.",
  "properties": {
    "defaults": {
      "$ref": "#/$defs/StationDefaults"
    },
    "domains": {
      "items": {
        "$ref": "#/$defs/Domain"
      },
      "title": "Domains",
      "type": "array"
    },
    "stations": {
      "items": {
        "$ref": "#/$defs/Station"
      },
      "title": "Stations",
      "type": "array"
    }
  },
  "required": [
    "stations"
  ],
  "title": "StationsFile",
  "type": "object"
}
