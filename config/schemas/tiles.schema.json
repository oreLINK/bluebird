{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bluebird schemas`. Do not edit by hand.",
  "$defs": {
    "Localized": {
      "additionalProperties": false,
      "description": "A user-facing string in every supported UI language.",
      "properties": {
        "fr": {
          "minLength": 1,
          "title": "Fr",
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        }
      },
      "required": [
        "fr",
        "en"
      ],
      "title": "Localized",
      "type": "object"
    },
    "Tile": {
      "additionalProperties": false,
      "description": "A KPI container displayed on the page.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "description": "Frontend tile component id (web/src/tiles/registry.ts).",
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "title": "Type",
          "type": "string"
        },
        "kpis": {
          "items": {
            "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Kpis",
          "type": "array"
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/Localized"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to the first KPI's name. Must contain `{period}`, replaced by the period label (e.g. 'Neige {period}' -> 'Neige ce soir')."
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon"
        },
        "periods": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Periods to show a tile for; defaults to every period of its KPIs.",
          "title": "Periods"
        },
        "options": {
          "additionalProperties": true,
          "title": "Options",
          "type": "object"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "Tile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema of ``config/tiles.yaml``.",
  "properties": {
    "tiles": {
      "items": {
        "$ref": "#/$defs/Tile"
      },
      "title": "Tiles",
      "type": "array"
    }
  },
  "required": [
    "tiles"
  ],
  "title": "TilesFile",
  "type": "object"
}
