{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `bluebird schemas`. Do not edit by hand.",
  "$defs": {
    "DiamondElevation": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "title": "Base",
          "type": "integer"
        },
        "mid": {
          "title": "Mid",
          "type": "integer"
        },
        "summit": {
          "title": "Summit",
          "type": "integer"
        }
      },
      "required": [
        "base",
        "mid",
        "summit"
      ],
      "title": "DiamondElevation",
      "type": "object"
    },
    "DiamondKpi": {
      "additionalProperties": false,
      "properties": {
        "kpi_id": {
          "title": "Kpi Id",
          "type": "string"
        },
        "aggregator_version": {
          "title": "Aggregator Version",
          "type": "string"
        },
        "periods": {
          "description": "Periods not over yet, by start time.",
          "items": {
            "$ref": "#/$defs/DiamondKpiPeriod"
          },
          "title": "Periods",
          "type": "array"
        }
      },
      "required": [
        "kpi_id",
        "aggregator_version",
        "periods"
      ],
      "title": "DiamondKpi",
      "type": "object"
    },
    "DiamondKpiPeriod": {
      "additionalProperties": false,
      "description": "The ranking of one KPI for one period of one ski day.",
      "properties": {
        "key": {
          "description": "Stable id across runs, e.g. `evening@2026-12-14`.",
          "title": "Key",
          "type": "string"
        },
        "period_id": {
          "description": "Period id from config/periods.yaml.",
          "title": "Period Id",
          "type": "string"
        },
        "ski_day": {
          "format": "date",
          "title": "Ski Day",
          "type": "string"
        },
        "start": {
          "description": "Local time, with UTC offset.",
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "description": "Local time, with UTC offset. Hidden afterwards.",
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "generated_at": {
          "description": "When these values were computed; older than the payload = stale.",
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "ranking": {
          "description": "Sorted by probability, descending.",
          "items": {
            "$ref": "#/$defs/DiamondRankingEntry"
          },
          "title": "Ranking",
          "type": "array"
        }
      },
      "required": [
        "key",
        "period_id",
        "ski_day",
        "start",
        "end",
        "generated_at",
        "ranking"
      ],
      "title": "DiamondKpiPeriod",
      "type": "object"
    },
    "DiamondRankingEntry": {
      "additionalProperties": false,
      "properties": {
        "station_id": {
          "title": "Station Id",
          "type": "string"
        },
        "probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability",
          "type": "number"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "window_start": {
          "description": "Local time, with UTC offset.",
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        },
        "window_end": {
          "description": "Local time, with UTC offset.",
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "members": {
          "title": "Members",
          "type": "integer"
        },
        "drivers": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Drivers",
          "type": "object"
        }
      },
      "required": [
        "station_id",
        "probability",
        "confidence",
        "window_start",
        "window_end",
        "members",
        "drivers"
      ],
      "title": "DiamondRankingEntry",
      "type": "object"
    },
    "DiamondSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "License"
        }
      },
      "required": [
        "id",
        "name",
        "url",
        "license"
      ],
      "title": "DiamondSource",
      "type": "object"
    },
    "DiamondStation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "short_name": {
          "description": "Compact name for tiles (falls back to `name`).",
          "title": "Short Name",
          "type": "string"
        },
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "elevation": {
          "$ref": "#/$defs/DiamondElevation"
        },
        "aspects": {
          "items": {
            "type": "string"
          },
          "title": "Aspects",
          "type": "array"
        },
        "website": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Website"
        }
      },
      "required": [
        "id",
        "name",
        "short_name",
        "lat",
        "lon",
        "elevation",
        "aspects",
        "website"
      ],
      "title": "DiamondStation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``diamond/{massif_id}/latest.json`` and ``diamond/{massif_id}/{date}.json``.",
  "properties": {
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "massif_id": {
      "title": "Massif Id",
      "type": "string"
    },
    "forecast_date": {
      "description": "Ski day of the run (local date, before 06:00: the day before).",
      "format": "date",
      "title": "Forecast Date",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "timezone": {
      "title": "Timezone",
      "type": "string"
    },
    "stations": {
      "additionalProperties": {
        "$ref": "#/$defs/DiamondStation"
      },
      "title": "Stations",
      "type": "object"
    },
    "kpis": {
      "additionalProperties": {
        "$ref": "#/$defs/DiamondKpi"
      },
      "title": "Kpis",
      "type": "object"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/DiamondSource"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "massif_id",
    "forecast_date",
    "generated_at",
    "timezone",
    "stations",
    "kpis",
    "sources"
  ],
  "title": "DiamondMassifDaily",
  "type": "object"
}
